NODE_ENV=development
HOST=127.0.0.1
PORT=9000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/MiniMirthDev
PG_SCHEMA=public
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Generate independently: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=3600
JWT_ISSUER=mini-mirth
JWT_AUDIENCE=mini-mirth-ui
CONFIG_ENCRYPTION_KEY=
INBOUND_API_KEY=
PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000,http://127.0.0.1:9000
HL7_ENABLED=true
HL7_HOST=127.0.0.1
HL7_PORT=2575
HL7_ALLOWED_IPS=127.0.0.1,::1
INBOUND_BASE_URL=http://localhost:9000
INBOUND_PATH=/api/inbound
OUTBOUND_ALLOWED_HOSTS=
PAYLOAD_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=10000
SCRIPT_TIMEOUT_MS=1000
SCRIPT_MEMORY_MB=16
SCRIPT_CONCURRENCY=4
LOG_LEVEL=info
MESSAGE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RETRY_POLL_MS=5000
SHUTDOWN_TIMEOUT_MS=30000

# V2 hardening: placeholders only; keep current and previous keys in a secret manager.
CONFIG_ENCRYPTION_KEY_ID=current
CONFIG_ENCRYPTION_PREVIOUS_KEYS={}
UI_ACCESS_TOKEN_SECONDS=300
REFRESH_TOKEN_SECONDS=604800
PG_SSL_CA_FILE=
TRUST_PROXY=
RETENTION_ENABLED=false
INBOUND_IDEMPOTENCY_MODE=OPTIONAL
# 0 preserves reservations until message retention; enable TTL only with downstream approval.
IDEMPOTENCY_RETENTION_HOURS=0
MAX_ACTIVE_INBOUND=32
MAX_PENDING_MESSAGES=10000
MAX_ACTIVE_DELIVERY=16
MAX_DELIVERY_PER_DESTINATION=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
MLLP_MAX_CONNECTIONS=64
MLLP_TLS_ENABLED=false
MLLP_TLS_CERT_FILE=
MLLP_TLS_KEY_FILE=
MLLP_TLS_CA_FILE=
MLLP_TLS_REQUIRE_CLIENT_CERT=true
MLLP_PLAINTEXT_TRUSTED_NETWORK=false
MASK_JSON_PATHS=patient,patientName,patientId,mrn,medicalRecordNumber,password,token,apiKey,authorization,secret
MASK_HL7_PATHS=PID.2,PID.3,PID.4,PID.5,PID.6,PID.7,PID.8,PID.11,PID.13,PID.14,PID.19,OBX.5,NTE.3
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300
ALERT_QUEUE_AGE_SECONDS=300
# Optional ENV_FILE supports a mounted dotenv secret file (process environment wins).
# Backup tools require explicit BACKUP_DATABASE_URL, BACKUP_ENCRYPTION_KEY_FILE,
# BACKUP_DIRECTORY and RESTORE_DISPOSABLE_CONFIRMED. Never default to application DB.
