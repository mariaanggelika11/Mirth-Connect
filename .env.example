NODE_ENV=development
HOST=127.0.0.1
PORT=9000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/MiniMirthDev
PG_SCHEMA=public
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Generate independently: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=3600
JWT_ISSUER=mini-mirth
JWT_AUDIENCE=mini-mirth-ui
CONFIG_ENCRYPTION_KEY=
INBOUND_API_KEY=
PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000,http://127.0.0.1:9000
HL7_ENABLED=true
HL7_HOST=127.0.0.1
HL7_PORT=2575
HL7_ALLOWED_IPS=127.0.0.1,::1
INBOUND_BASE_URL=http://localhost:9000
INBOUND_PATH=/api/inbound
OUTBOUND_ALLOWED_HOSTS=
PAYLOAD_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=10000
SCRIPT_TIMEOUT_MS=1000
SCRIPT_MEMORY_MB=16
SCRIPT_CONCURRENCY=4
LOG_LEVEL=info
MESSAGE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RETRY_POLL_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
