{
  "name": "mirth-connect-monolith",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build --workspaces",
    "start": "node server/dist/server.js",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint client/src client/test client/e2e server/src server/test scripts",
    "format": "prettier --write client/src client/test client/e2e server/src server/test scripts *.json *.mjs *.ts client/*.json client/*.ts server/*.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx server/src/scripts/migrate.ts",
    "bootstrap:admin": "npm run bootstrap:admin -w server",
    "test:e2e": "playwright test",
    "test:sql": "tsx --test server/test/sql.integration.ts",
    "format:check": "prettier --check client/src client/test client/e2e server/src server/test scripts *.json *.mjs *.ts client/*.json client/*.ts server/*.json",
    "secrets:rotate": "tsx server/src/scripts/rotate-secrets.ts",
    "db:backup": "tsx server/src/scripts/backup.ts backup",
    "db:restore": "tsx server/src/scripts/backup.ts restore",
    "db:verify-restore": "tsx server/src/scripts/backup.ts verify-restore",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "test:backup": "node scripts/backup-smoke.mjs",
    "docs:check": "node scripts/check-openapi.mjs",
    "db:reset-development": "tsx server/src/scripts/reset-development.ts",
    "db:verify-development-reset": "tsx server/src/scripts/verify-development-reset.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "overrides": {
    "@types/express": "4.17.23",
    "@types/express-serve-static-core": "4.19.7"
  }
}
